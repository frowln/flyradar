# Development. See README.md for every variable and its default.
PORT=3000
# Matches the root docker-compose.yml (Postgres on 5555, Redis on 6381).
DATABASE_URL=postgresql://skyatlas:dev@localhost:5555/skyatlas
REDIS_URL=redis://localhost:6381
# Flight lookup. AeroDataBox wins when set; AviationStack is the fallback;
# neither = demo mode (invented flights, never cached). See README "Data providers".
# AERODATABOX_KEY=
# RapidAPI by default; prod.api.market for an API.market key.
# AERODATABOX_HOST=aerodatabox.p.rapidapi.com
AVIATIONSTACK_KEY=your_key_here
# Recent real tracks for GET /flights/track. Unset = 404 not_configured.
# FR24_API_KEY=
# Cloud forecast for POST /weather/clouds. Unset = free host (non-commercial only).
# OPEN_METEO_KEY=
# Unset in development = request signatures are not checked.
# AUTH_HMAC_SECRET=
