# Production, read by docker-compose.prod.yml (env_file). See README.md.
PORT=3000
DATABASE_URL=postgresql://skyatlas:STRONG_PASSWORD_HERE@postgres:5432/skyatlas
REDIS_URL=redis://redis:6379
NODE_ENV=production
AVIATIONSTACK_KEY=your_key_here
# Required in production. Same value as the app's EXPO_PUBLIC_AUTH_HMAC_SECRET.
# Anti-abuse only: it ships inside the app, so it is not authentication.
AUTH_HMAC_SECRET=generate_with_openssl_rand_hex_32
# Bearer token for GET /metrics (internal network only). Unset = 404.
METRICS_TOKEN=generate_with_openssl_rand_hex_32
REVENUECAT_SECRET_KEY=
APPLE_BUNDLE_ID=com.skyatlas.app
