{
  "expo": {
    "name": "SkyAtlas",
    "slug": "skyatlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skyatlas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkyAtlas reads the barcode on your boarding pass. Nothing is stored or sent.",
        "NSLocationWhenInUseUsageDescription": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone."
      },
      "userInterfaceStyle": "dark",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E11"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.skyatlas.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#0B0E11"
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF9E3D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone.",
          "locationAlwaysAndWhenInUsePermission": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone.",
          "locationAlwaysPermission": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SkyAtlas reads the barcode on your boarding pass. Nothing is stored or sent.",
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native",
      "@maplibre/maplibre-react-native"
    ],
    "locales": {
      "ru": "./locales/ru.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "ja": "./locales/ja.json"
    },
    "description": "What is out of the airplane window — mountains, seas, cities and borders along your route, offline."
  }
}
