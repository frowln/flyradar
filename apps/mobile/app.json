{
  "expo": {
    "name": "SkyAtlas",
    "slug": "skyatlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E11"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.skyatlas.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkyAtlas reads the barcode on your boarding pass. Nothing is stored or sent.",
        "NSLocationWhenInUseUsageDescription": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone."
      },
      "userInterfaceStyle": "dark"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E11"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.skyatlas.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "In flight, the phone’s GPS shows more precisely what is under the aircraft. Your location never leaves the phone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SkyAtlas reads the barcode on your boarding pass. Nothing is stored or sent.",
          "recordAudioAndroid": false
        }
      ],
      "@sentry/react-native",
      "@maplibre/maplibre-react-native"
    ],
    "locales": {
      "ru": "./locales/ru.json",
      "de": "./locales/de.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "ja": "./locales/ja.json"
    }
  }
}
