# Everything here is optional: without any of it the app prepares and flies
# flights entirely on the phone. See the table in the root README.

# Backend URL. Leave unset for a fully on-device build.
# EXPO_PUBLIC_API_URL=https://api.example.com
# Enable accounts, reviews and people (requires the backend above).
# EXPO_PUBLIC_SOCIAL=1
# Request signing; must equal the server's AUTH_HMAC_SECRET when it sets one.
# EXPO_PUBLIC_AUTH_HMAC_SECRET=

# Purchases. Unset = no paywall, everything open.
# EXPO_PUBLIC_RC_KEY=

# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_POSTHOG_KEY=

# Public pages for the privacy policy and terms of use (required by the App
# Store). Unset = the Markdown files in the repository.
# EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy.html
# EXPO_PUBLIC_TERMS_URL=https://example.com/terms.html
